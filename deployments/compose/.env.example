# Copy to .env (make compose-up does this if .env is missing) and adjust.
# These are local development credentials only.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=warehouse
S3_REGION=us-east-1

# Network for image builds. Use "host" if `go mod download` times out inside
# Docker builds (Docker's bridge network cannot reach the Go module proxy).
BUILD_NETWORK=default

# Subnet of the compose network; change it if it collides with another network.
COMPOSE_SUBNET=172.28.0.0/24
